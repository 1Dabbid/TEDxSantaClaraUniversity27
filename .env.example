# Copy to .env (or set in Vercel > Project > Settings > Environment Variables).
# Never commit real values.

# Keystatic GitHub mode (optional). Only when ALL FOUR are set at build time does the
# CMS use GitHub storage on 1Dabbid/TEDxSantaClaraUniversity27 (see keystatic.config.ts
# and src/lib/admin.ts). Without all four, a production build (npm run build, any
# Vercel deployment) switches the admin off: /keystatic and /api/keystatic/* answer 404.
# Under `npm run dev` the admin always works (local files without the variables).
# The Keystatic setup flow at /keystatic/setup (run with `npm run dev`) creates the
# GitHub App and writes all four to .env for you; see docs/DEPLOY.md. On Vercel set
# all four for Production, then redeploy (NEXT_PUBLIC_* is baked in at build time).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# At least 32 random characters (encrypts the editor's sign-in cookie), e.g. the output
# of `openssl rand -hex 32`.
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Optional: extra frame origins for a ticket checkout embed that nests another
# frame, space-separated, e.g. "https://js.stripe.com". Read at build time.
# CSP_FRAME_SRC=

# Optional, build only: `ANALYZE=1 npm run build` emits browser source maps.
# ANALYZE=1

# Search indexing (no need to set on Vercel, which provides it). Only builds where
# VERCEL_ENV is unset or "production" may be indexed; "preview"/"development" builds
# get robots.txt Disallow: / and a noindex meta tag. See docs/DEPLOY.md.
# VERCEL_ENV=preview
