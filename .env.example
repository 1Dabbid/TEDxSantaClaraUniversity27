# Copy to .env (or set in Vercel > Project > Settings > Environment Variables).
# Never commit real values.

# Keystatic GitHub mode (optional). When NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG is set,
# the CMS switches from local file storage to GitHub storage on
# 1Dabbid/TEDxSantaClaraUniversity27 (see keystatic.config.ts). The Keystatic setup
# flow at /keystatic/setup (run with `npm run dev`) creates the GitHub App and writes
# all four to .env for you; see docs/DEPLOY.md. Set all four on Vercel.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Random string, at least 32 characters (encrypts the editor's sign-in cookie).
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Optional: extra frame origins for a ticket checkout embed that nests another
# frame, space-separated, e.g. "https://js.stripe.com". Read at build time.
# CSP_FRAME_SRC=

# Optional, build only: `ANALYZE=1 npm run build` emits browser source maps.
# ANALYZE=1
